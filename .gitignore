.env
.env.local
backend/.env

# Database & SQLite files
*.db
*.sqlite
*.sqlite3

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db
